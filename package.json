{
  "name": "f1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "readiness": "node scripts/results-readiness.mjs",
    "readiness:report": "node scripts/results-readiness.mjs --report",
    "results:watch": "node scripts/results-watch.mjs",
    "replays": "node scripts/build-replays.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail",
    "worker:types": "wrangler types",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  }
}
