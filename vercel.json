{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/openf1/:path*",
      "destination": "https://api.openf1.org/:path*"
    },
    {
      "source": "/api/results/:path*",
      "destination": "https://boxthislap-results.fabrizio-dec90.workers.dev/api/results/:path*"
    },
    {
      "source": "/api/status",
      "destination": "https://boxthislap-results.fabrizio-dec90.workers.dev/api/status"
    },
    {
      "source": "/health",
      "destination": "https://boxthislap-results.fabrizio-dec90.workers.dev/health"
    },
    {
      "source": "/news/autosport",
      "destination": "https://www.autosport.com/rss/f1/news/"
    },
    {
      "source": "/news/motorsport",
      "destination": "https://www.motorsport.com/rss/f1/news/"
    },
    {
      "source": "/news/racefans",
      "destination": "https://www.racefans.net/feed/"
    },
    {
      "source": "/news/bbc",
      "destination": "https://feeds.bbci.co.uk/sport/formula1/rss.xml"
    },
    {
      "source": "/news/therace",
      "destination": "https://www.the-race.com/rss/"
    }
  ],
  "headers": [
    {
      "source": "/news/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
